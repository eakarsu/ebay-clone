# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ebay_clone
DB_USER=postgres
DB_PASSWORD=postgres
# Prefer DATABASE_URL in production; keep individual DB_* values for local use.
DATABASE_URL=
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=4000
NODE_ENV=development

# Payments. Never commit live values. Rotate webhook secrets independently.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_RATE=0.10
ALLOW_DIRECT_PAYMENT_METHODS=false

# Durable event delivery (HMAC-signed JSON outbox messages).
EVENT_SINK_URL=
EVENT_SINK_SECRET=
OUTBOX_POLL_MS=10000

# Required production provider adapters. Startup fails closed if absent.
TAX_PROVIDER_BASE_URL=
SHIPPING_PROVIDER_BASE_URL=
KYC_PROVIDER_BASE_URL=

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# AI / OpenRouter (used for image search, shopping assistant, content moderation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Set to 'true' to run the AI content classifier alongside the regex moderator.
AI_MODERATION=false

# Referral rewards — all in the default currency, credited to user_wallets.
REFERRAL_REWARD_SIGNUP=5.00
REFERRAL_REWARD_FIRST_PURCHASE=10.00
REFERRAL_WELCOME_CREDIT=5.00

# Frontend origin used to build referral links.
FRONTEND_URL=http://localhost:3000
